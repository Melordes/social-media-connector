{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Social Media Connector",
  "version": "0.1.1",
  "identifier": "com.socialmediaconnector.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Social Media Connector",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: data: blob:",
        "media-src": "'self' asset: http://asset.localhost https: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "shortDescription": "Manage several social media accounts in one place",
    "longDescription": "Connect Mastodon, Bluesky, Misskey, X, Facebook Pages, LinkedIn, Reddit, Tumblr, Telegram and Discord accounts; read their streams, and write, schedule and track posts from one window.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Social Media Connector",
    "copyright": "Public domain (The Unlicense)"
  }
}
